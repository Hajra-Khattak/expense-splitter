rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // get() sees the database BEFORE the write. Use it for existing groups.
    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Same two uids always give the same id, so a pair can only have one friendship doc.
    function pairKey(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'description', 'currency', 'createdBy', 'createdAt', 'archived', 'inviteCode', 'memberIds'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.archived == false
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.currency in ['PKR', 'USD', 'EUR', 'GBP', 'AED', 'SAR', 'INR']
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8;

      // Join with an invite: a non-member adds only their own uid to memberIds.
      // existsAfter() ties it to the member doc created in the SAME batch, and that
      // member doc rule checks the invite code.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(groupId);

        // Same batch as the group: the group does not exist yet, so get() would fail.
        // getAfter() reads the state as it will be once the batch commits.
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.role == 'admin'
          && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;

        // Join with an invite code. The group already exists, so get() is right for the code.
        // getAfter() checks that the same batch adds this uid to memberIds.
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'joinedAt', 'inviteCode'])
          && request.resource.data.role == 'member'
          && request.resource.data.inviteCode == get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode
          && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds)
          && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        allow update, delete: if false;
      }

      match /activity/{activityId} {
        allow read: if isMember(groupId);

        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        allow update, delete: if false;
      }
    }

    // Public name card. Anyone signed in can get one by uid; nobody can list them.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.photoURL is string;
      allow delete: if false;
    }

    // Find a person by exact email. get only, never list. Only the owner of the email writes it.
    match /emailLookup/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if false;
    }

    // One doc per pair of people. The requester creates it as pending, the OTHER person accepts.
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userIds', 'requestedBy', 'status', 'names', 'createdAt'])
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds[0] != request.resource.data.userIds[1]
        && request.auth.uid in request.resource.data.userIds
        && pairId == pairKey(request.resource.data.userIds[0], request.resource.data.userIds[1])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.names is map
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time;

      // Decline, cancel and unfriend
      allow delete: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      // The group exists by now (step 2), so get() is correct here.
      // A second set() on an existing code counts as an update, which is denied.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;

      allow update, delete: if false;
    }
  }
}
